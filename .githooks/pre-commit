#!/bin/bash

FILES=$(git diff --cached --name-status)

if [[ $FILES =~ .drawio ]]; then
    echo
    echo --- Auto-generating SVG files for architecture diagrams ---
    for DRAWIO_FILE in $(git diff --cached --name-only | grep '\.drawio$'); do
        SVG_FILE="${DRAWIO_FILE%.drawio}.svg"
        echo "Exporting ${DRAWIO_FILE} → ${SVG_FILE}"
        /Applications/draw.io.app/Contents/MacOS/draw.io -x "${DRAWIO_FILE}" -f svg -s 1 -o "${SVG_FILE}"
        git add "${SVG_FILE}"
    done
    echo
fi

if [[ $FILES =~ README\.md ]]; then
    echo
    echo --- Updating table of contents in README files ---
    for README_FILE in $(git diff --cached --name-only | grep 'README\.md$'); do
        echo "Updating TOC in ${README_FILE}"
        npx -y markdown-toc -i "${README_FILE}"
        git add "${README_FILE}"
    done
    echo
fi

exit 0
